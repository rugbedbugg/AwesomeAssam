# Build artifacts
build/
dist/
*.egg-info/

# Virtual environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Models
models/*
!models/.gitkeep

# Model weights and checkpoints: never commit these, wherever they are unpacked.
*.nemo
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.bin

# Raw and derived audio: never commit research audio blobs.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated experiments (structure is tracked, results are not).
experiments/*
!experiments/.gitkeep

# Local tooling / secrets
.env
.env.*
*.local.yaml

# Editor and OS clutter
.idea/
.vscode/
*.swp
.DS_Store
